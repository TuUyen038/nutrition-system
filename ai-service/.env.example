# Embedding + vector store
EMBED_MODEL=intfloat/multilingual-e5-base
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=nutrition_kb

# Chunking: giá trị dự phòng khi tài liệu/profile không khai báo.
# Cách chunk của từng tài liệu đặt bằng `chunk_profile` trong front matter (xem data/chunk_profiles.json)
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# Retrieval
TOP_K=5

# Reranker (cross-encoder đa ngôn ngữ) chấm lại ứng viên. Lần đầu sẽ tải model (hàng trăm MB đến ~2 GB).
# Model nhẹ hơn nếu máy yếu: cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Tắt mặc định để giữ khả năng truy xuất cross-language Việt <-> Anh.
RERANK_ENABLED=0
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Số ứng viên lấy cho MỖI ngôn ngữ có trong kho (vi, en...) trước khi rerank
RERANK_CANDIDATES_PER_LANG=10
# Ngưỡng "chunk liên quan" - chỉnh theo dòng gợi ý của scripts/eval_generic.py
RELEVANCE_THRESHOLD=0.3
# Ngưỡng dùng khi tắt rerank (điểm cosine của e5)
VECTOR_RELEVANCE_THRESHOLD=0.82
VECTOR_RELEVANCE_THRESHOLD_EN=0.50
VECTOR_RELEVANCE_THRESHOLD_VI=0.82

# Intent Router - chỉnh sau khi chạy eval_router.py
ROUTER_KEYWORD_BOOST=0.05
ROUTER_MARGIN=0.015
# Cách biệt tối thiểu giữa 2 nhóm con của personal; nhỏ hơn -> sub_intent=null (Node cấp đủ tool)
ROUTER_SUB_MARGIN=0.01
# out_of_scope chỉ được chọn khi hơn nhóm thứ hai ít nhất ngưỡng này (và không có từ khóa dinh dưỡng/tập luyện)
ROUTER_OOS_MARGIN=0.005

# Bảo vệ endpoint nội bộ (để trống = không kiểm tra). Phải trùng AI_INTERNAL_KEY bên Node.
INTERNAL_KEY=

# Chỉ cần cho scripts/image_to_md.py
GEMINI_API_KEY=
